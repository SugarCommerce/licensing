{
    "name": "sugarcommerce/licensing",
    "version": "1.1.0",
    "description": "Licence-key seats for software sellers: validate a key (and one installation of it) with a reason a client can show, claim a seat atomically so parallel activations cannot overrun the limit, and release it by an instance id the server issued. Storage is yours, behind one interface. Zero dependencies.",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "homepage": "https://github.com/sugarcommerce/licensing",
    "authors": [
        {
            "name": "David Sherlock",
            "homepage": "https://arraypress.com/"
        }
    ],
    "keywords": [
        "licensing",
        "license-key",
        "activation",
        "seats",
        "software",
        "drm"
    ],
    "require": {
        "php": ">=8.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "SugarCommerce\\Licensing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SugarCommerce\\Licensing\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "preferred-install": "dist"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "support": {
        "issues": "https://github.com/sugarcommerce/licensing/issues",
        "source": "https://github.com/sugarcommerce/licensing"
    }
}
